# .env.example — template showing which environment variables this app
# needs. This file IS safe to commit to GitHub — it has no real secrets
# or personal paths in it, just placeholder values.
#
# To use: copy this file, rename the copy to ".env", then fill in real
# values for your own machine. .env itself is gitignored and never gets
# pushed — it's specific to whoever is running the app.

# A random secret string Flask uses to sign session cookies. Use a long,
# random value — don't reuse the example below in a real deployment.
SECRET_KEY=change-this-to-something-random-and-secret

# SQLite database filename (usually fine left as-is)
DB_FILE=chats.db

# Absolute path to your ChromaDB storage folder. This MUST be an
# absolute path specific to your machine, e.g.:
#   Windows: C:\Users\yourname\path\to\chroma-storage
#   Mac/Linux: /home/yourname/path/to/chroma-storage
CHROMA_PATH=/path/to/your/chroma/storage

# Which Ollama models to use for text and image messages. Must already
# be pulled locally (ollama pull <model-name>) before the app can use them.
TEXT_MODEL=gemma2:9b
VISION_MODEL=llava

# Which port Flask runs on
FLASK_PORT=5000
